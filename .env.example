# Application
NODE_ENV=development
PORT=5000

# PostgreSQL (Neon example — use pooler host for app + migrations)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tvet_memo

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated frontend origins; localhost any port allowed in development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://localhost:8081

# Super admin bootstrap (used only by `pnpm seed:super-admin`)
SUPER_ADMIN_EMAIL=admin@memo.platform
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin

# Demo seed users default password (`pnpm db:seed`)
SEED_DEFAULT_PASSWORD=Test@12345

# Portal base URL host (setup links in welcome emails point here, e.g. https://tvetmemo.co.ke/setup)
PORTAL_BASE_DOMAIN=tvetmemo.co.ke
SETUP_TOKEN_EXPIRY_HOURS=72

# Azure Communication Services (Email)
# Connection string from Azure Portal → Communication Services → Keys
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<primary-key>
# Verified sender from Azure Portal → Email Communication Services → Domains
AZURE_EMAIL_SENDER_ADDRESS=DoNotReply@<your-domain>.azurecomm.net
